[gd_resource type="ShaderMaterial" format=3 uid="uid://chu1gks7oi4d5"]

[sub_resource type="Shader" id="Shader_tu1u5"]
code = "shader_type spatial;
render_mode diffuse_lambert, specular_disabled;

// --- HEIGHT COLORING SETTINGS ---
uniform bool use_height_coloring = true;
uniform float band_smoothness : hint_range(0.001, 0.2) = 0.05;

uniform float level_low : hint_range(0.0, 1.0) = 0.25;
uniform float level_mid : hint_range(0.0, 1.0) = 0.55;
uniform float level_high : hint_range(0.0, 1.0) = 0.80;

uniform vec4 color_deep : source_color = vec4(0.1, 0.3, 0.6, 1.0);  // Low valleys / Ocean
uniform vec4 color_low : source_color = vec4(0.2, 0.6, 0.3, 1.0);   // Lowlands / Grass
uniform vec4 color_mid : source_color = vec4(0.4, 0.35, 0.3, 1.0);  // Mountains / Rock
uniform vec4 color_high : source_color = vec4(0.9, 0.9, 0.95, 1.0); // Peaks / Snow

// --- ORIGINAL UNIFORMS ---
uniform vec4 albedo_color : source_color = vec4(1.0);
uniform float step_smoothness : hint_range(0.0, 1.0, 0.05) = 0.1;
uniform float shadow_darkness : hint_range(0.0, 1.0, 0.05) = 0.4;

uniform vec4 stripe_color : source_color = vec4(0.1, 0.15, 0.12, 1.0);
uniform float stripe_width : hint_range(0.01, 1.0) = 0.1;
uniform float stripe_angle : hint_range(0.0, 6.28) = 0.785; // 45 deg
uniform float stripe_scale : hint_range(1.0, 50.0) = 15.0;
uniform float stripe_blend : hint_range(0.0, 1.0, 0.05) = 1.0;

uniform float dot_scale : hint_range(1.0, 70.0) = 42.0;
uniform float dark_threshold : hint_range(0.0, 1.0) = 0.2;
uniform float max_dot_radius : hint_range(0.0, 1.0) = 0.2;
uniform vec4 dot_color : source_color = vec4(1.0);


void fragment() {
	if (use_height_coloring) {
		// COLOR.r holds the 0.0 to 1.0 height value generated by the GDScript
		float h = COLOR.r;
		
		// Blend smoothly between the 4 height levels
		float t1 = smoothstep(level_low - band_smoothness, level_low + band_smoothness, h);
		float t2 = smoothstep(level_mid - band_smoothness, level_mid + band_smoothness, h);
		float t3 = smoothstep(level_high - band_smoothness, level_high + band_smoothness, h);

		vec3 terrain = color_deep.rgb;
		terrain = mix(terrain, color_low.rgb, t1);
		terrain = mix(terrain, color_mid.rgb, t2);
		terrain = mix(terrain, color_high.rgb, t3);

		ALBEDO = terrain;
	} else {
		ALBEDO = albedo_color.rgb;
	}
}

void light() {
	float ndotl = clamp(dot(NORMAL, LIGHT), 0.0, 1.0) * ATTENUATION;
	float lit = smoothstep(0.5 - step_smoothness, 0.5 + step_smoothness, ndotl);

	// Screen-space diagonal stripes, aspect-corrected
	vec2 screen = SCREEN_UV;
	screen.x *= VIEWPORT_SIZE.x / VIEWPORT_SIZE.y;
	
	vec2 grid_uv = screen * dot_scale;
	vec2 cell_uv = fract(grid_uv) - 0.5; // -0.5 to 0.5, centered in each cell
	float dot_radius = max(0.0, lit - dark_threshold) * max_dot_radius;
	float dist_from_center = length(cell_uv);
	float dot_shape = step(dist_from_center, dot_radius);
	
	float c = cos(stripe_angle);
	float s = sin(stripe_angle);
	float diag = screen.x * c + screen.y * s;
	float stripe = step(stripe_width, fract(diag * stripe_scale));

	float stripe_mask = mix(1.0, stripe, stripe_blend);
	stripe_mask = mix(stripe_mask, 1.0, lit); // stripes only show in shadow

	// Replaced static albedo_color.rgb with ALBEDO so height colors inherit toon shading
	vec3 base = mix(ALBEDO * (1.0 - shadow_darkness), ALBEDO, lit);
	base = mix(stripe_color.rgb, base, stripe_mask);
	base = mix(base, dot_color.rgb, dot_shape);

	DIFFUSE_LIGHT += base * LIGHT_COLOR / PI;
}
"

